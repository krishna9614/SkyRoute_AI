# Gemini API key for the ADK agent (Google AI Studio key).
GOOGLE_API_KEY=

# Use Google AI Studio (API key) instead of Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Gemini model the root agent runs on.
SKYROUTE_MODEL=gemini-2.5-flash

# MCP server endpoints (streamable HTTP).
WEATHER_MCP_URL=http://127.0.0.1:8001/weather-mcp
PLACES_MCP_URL=http://127.0.0.1:8002/places-mcp
